rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isArenaAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'miniamikaren@gmail.com';
    }

    match /arenaData/{document=**} {
      allow read: if true;
      allow create, update, delete: if isArenaAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
